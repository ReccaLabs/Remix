# Copy to infra/docker/.env to override host ports (e.g. when 5432 is already taken).
# Dev only — every credential in this stack is an obviously-dev value.
POSTGRES_PORT=5432
VALKEY_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=8333
# Local staging (pnpm stack:prod): host ports of the production web and API images.
WEB_PORT=3001
API_PORT=4000
