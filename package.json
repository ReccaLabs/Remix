{
  "name": "remix",
  "private": true,
  "description": "ReMix by Recca Labs — multi-tenant LMS SaaS for Sri Lankan tuition",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "pnpm --filter @remix/site dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.4",
    "typescript": "~7.0.2"
  }
}
