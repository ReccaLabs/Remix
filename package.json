{
  "name": "remix",
  "private": true,
  "description": "ReMix by Recca Labs — multi-tenant LMS SaaS for Sri Lankan tuition",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "pnpm --filter @remix/site dev",
    "dev:web": "pnpm --filter @remix/web dev",
    "dev:api": "pnpm --filter @remix/api dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @remix/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.5",
    "typescript": "~7.0.2"
  }
}
