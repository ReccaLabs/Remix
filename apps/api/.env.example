# apps/api environment — copy to .env (git-ignored). Validated at boot (src/config/config.ts);
# an invalid value stops the process with a list of variable names.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Peers allowed to set X-Forwarded-Host/-Proto/-For: IPs, CIDRs or loopback/linklocal/uniquelocal.
# Prod: the edge proxy + web nodes on the private network (+ Cloudflare ranges). Never "*".
TRUST_PROXY=loopback

# Hosts whose sub-domains are institute slugs (remix.lk in prod).
TENANT_BASE_DOMAINS=localhost
# Hosts serving the platform admin area (admin.remix.lk in prod).
PLATFORM_HOSTS=admin.localhost

# Secure cookies; defaults to true in production and must be true there.
COOKIE_SECURE=false

# Optional until the database module lands (Track A/E). Connects as remix_app.
DATABASE_URL=
