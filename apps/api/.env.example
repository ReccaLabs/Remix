# apps/api environment — copy to .env (git-ignored). Validated at boot (src/config/config.ts);
# an invalid value stops the process with a list of variable names.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Peers allowed to set X-Forwarded-Host/-Proto/-For: IPs, CIDRs or loopback/linklocal/uniquelocal.
# Prod: the edge proxy + web nodes on the private network (+ Cloudflare ranges). Never "*".
TRUST_PROXY=loopback

# Hosts whose sub-domains are institute slugs (remix.lk in prod).
TENANT_BASE_DOMAINS=localhost
# Hosts serving the platform admin area (admin.remix.lk in prod).
PLATFORM_HOSTS=admin.localhost

# Secure cookies; defaults to true in production and must be true there (behind https).
# true  → __Host-remix_session / __Host-remix_device with Secure
# false → remix_session / remix_device (plain-HTTP dev only)
COOKIE_SECURE=false

# Required. Postgres as remix_app (RLS-bound; the API refuses to boot as an owner/superuser).
# Matches infra/docker/compose.yaml (dev only). Never the remix_owner URL.
DATABASE_URL=postgres://remix_app:remix_app_dev_password@127.0.0.1:5432/remix

# HMAC key for SMS one-time codes (>= 32 chars, its own secret). Required in production; unset in
# development/tests uses a public dev value. Generate: openssl rand -base64 48
# AUTH_CODE_SECRET=
# SET-02: generate a LOCAL key once; keep it in your ignored .env and back it up securely.
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
# Required in production. No built-in dev key: changing it makes stored secrets unreadable.
INTEGRATIONS_KEY=
INTEGRATIONS_KEY_ID=v1
# Rotation: decrypt rows with the old key, re-encrypt with the new key/id; keep the old key
# securely until all rows have been migrated. Unknown key ids fail closed; no fallback key.

# MSG-01 platform SMS gateways (placeholders only; real values live in the host's secret store).
# Notify.lk is the primary; Text.lk an optional fallback. A gateway without all of its values is
# not used. Outside production the logging mock sends instead; production without a configured
# gateway fails SMS jobs visibly.
SMS_PRIMARY=notifylk
# SMS_FALLBACK=textlk
# SMS_HTTP_TIMEOUT_MS=8000
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=
# NOTIFYLK_SENDER_ID=
# TEXTLK_API_TOKEN=
# TEXTLK_SENDER_ID=
