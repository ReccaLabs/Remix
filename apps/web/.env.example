# apps/web server environment. Copy to .env.local for development. No secrets live here and
# nothing is NEXT_PUBLIC_*: none of these values reach the browser.
# Validated with Zod at server start (src/server/env.ts) — a bad value stops the server.

# The API on the private network. Server Components call it directly (ADR 0006).
# Dev: the API from apps/api (or `pnpm --filter @remix/web mock-api`).
API_INTERNAL_URL=http://localhost:4000

# Comma-separated hosts whose single-label sub-domains are institutes (<slug>.<base>).
# Dev: localhost → http://kamalphysics.localhost:3001. Prod: remix.lk
TENANT_BASE_DOMAINS=localhost

# Comma-separated exact hosts of the platform admin. Prod: admin.remix.lk
PLATFORM_HOSTS=admin.localhost

# Build-time only. `next dev` always proxies /api/v1/* to API_INTERNAL_URL; a production build
# does so only when built with WEB_API_REWRITE=true (local prod-like runs, E2E). In production
# the edge proxy routes /api/v1 to apps/api instead (ADR 0003).
# WEB_API_REWRITE=true
