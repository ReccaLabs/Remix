# Public values only — everything here ends up in the static HTML.
# Copy to .env.local for development. Never put secrets in NEXT_PUBLIC_* variables.

# WhatsApp number for "Chat on WhatsApp" links, international format without + (e.g. 9477xxxxxxx).
# If unset, WhatsApp links fall back to the /demo page.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudflare Turnstile site key (public). The SECRET key lives only in Cloudflare Pages env vars.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token (public, cookieless).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------------------------
# Server-side secrets for the Pages Function functions/api/lead.ts — documentation only.
# Next.js never reads these. Do NOT put them in .env.local and never prefix them NEXT_PUBLIC_.
# Production/preview: Cloudflare Pages → Settings → Variables and Secrets (type "Secret").
# Local `wrangler pages dev`: apps/site/.dev.vars (git-ignored). Never commit real values.
#
# TURNSTILE_SECRET_KEY  Turnstile secret key; the Function verifies every form token with it.
#                       Required — without it the Function rejects all leads (fails closed).
# RESEND_API_KEY        Resend API key for lead notification emails to sales@remix.lk.
#                       Optional — if unset, leads are still stored in D1 and email is skipped.
# ---------------------------------------------------------------------------------------------
