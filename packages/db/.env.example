# Copy to packages/db/.env (git-ignored). Values match infra/docker (dev only).

# remix_owner — migrations, seed and tenant:create only. Never give this to the API or a worker.
DATABASE_OWNER_URL=postgres://remix_owner:remix_owner_dev_password@127.0.0.1:5432/remix

# remix_app — what the API and workers use (RLS enforced). Read by apps, not by these CLIs.
DATABASE_URL=postgres://remix_app:remix_app_dev_password@127.0.0.1:5432/remix

# remix_platform / remix_readonly — separate pools (platform module, support queries).
DATABASE_PLATFORM_URL=postgres://remix_platform:remix_platform_dev_password@127.0.0.1:5432/remix
DATABASE_READONLY_URL=postgres://remix_readonly:remix_readonly_dev_password@127.0.0.1:5432/remix

# The seed refuses non-local hosts unless this is true. Never set it against production.
# SEED_ALLOW_REMOTE=true
